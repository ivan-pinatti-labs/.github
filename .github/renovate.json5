{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is the sole dependency-update bot in this repository as of the
  // migration off Dependabot: it now covers GitHub Actions (`github-actions`
  // manager, workflow files under .github/workflows/), pre-commit hook revs
  // (`pre-commit` manager, .pre-commit-config.yaml), and the development
  // container's base image digest (`dockerfile` manager). asdf was removed
  // from this organization on 2026-09-19, so the .tool-versions surface it
  // used to own is gone and pre-commit comes from Ubuntu. See
  // docs/MERGE_PIPELINE.md, "A dependency bot pull request", and README.md,
  // "Dependency policy", for the reasoning that carried over unchanged: no
  // `Pin Only` fast lane here, a bot pull request is graded exactly like a
  // human one, and both bots (now just this one, for this repository) share
  // the same seven day cooling window.
  extends: ["config:recommended"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is
  // the only place Renovate reports detection errors and rate-limited
  // updates.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not weekly. A weekly schedule stacked against minimumReleaseAge's
  // 7 day window below means a release that misses one week's slot by a day
  // waits a full extra week for the next one, so the oldest a package could
  // sit before merging was up to 14 days even though 7 was the intended
  // floor. Checking daily keeps the schedule's own period short enough that
  // it can no longer add more than a day on top of that floor.
  schedule: ["before 7am"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type this
  // config has not thought about arrives unlabelled and waits for a person
  // rather than merging on the strength of a default nobody chose.
  automerge: false,

  // Explicit rather than dropped, even though these four now cover
  // everything this repository has for Renovate to find. An explicit list
  // means a manager Renovate newly auto-detects because someone later adds a
  // package.json, a Dockerfile, or any other manager-recognised file needs a
  // deliberate addition here before it starts opening pull requests, rather
  // than silently picking it up the next time `config:recommended` widens
  // its own defaults.
  //
  // `dockerfile` watches the
  // base image digest that container is built on, scoped to
  // .devcontainer/Dockerfile by the packageRules entry further down so it
  // cannot start reading any other Dockerfile this repository later grows.
  enabledManagers: ["github-actions", "pre-commit", "dockerfile"],

  // Renovate's `pre-commit` manager ships `enabled: false` in its own
  // defaultConfig, unlike every other manager: being named in
  // enabledManagers above is necessary but not sufficient to turn it on.
  // Confirmed live with `renovate --platform=local --dry-run=extract`:
  // without this block, `.pre-commit-config.yaml` extracted zero
  // dependencies even though the manager was enabled above. See
  // https://docs.renovatebot.com/modules/manager/pre-commit/.
  "pre-commit": {
    enabled: true,
  },

  // A cooling window before an update is offered at all: a fresh supply
  // chain compromise has no advisory yet for any scanner to match, and age
  // is the only defence against that. Seven days for every manager here,
  // github-actions and pre-commit included, because both execute arbitrary
  // code (in CI holding a token, and on a developer's machine, respectively)
  // and are the larger attack surface, not the smaller one. See README.md,
  // "Both bots wait seven days".
  //
  // Not an absolute seven days for github-actions specifically: its
  // github-tags datasource derives releaseTimestamp from the tag's commit
  // date, not from a tag-push event, so a tag force-pushed to a new commit
  // can satisfy this window immediately rather than waiting out a fresh
  // seven days. github-actions is already pinned to a full commit SHA in
  // every workflow here (see .github/workflows/), which is the mitigation
  // Renovate's own docs recommend for this gap; there is no independent
  // control against a force-pushed tag beyond that.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose: later rules win on any key they share
    // with an earlier one, and the group rules below set a name and labels,
    // not automerge policy, so none of them can accidentally override this
    // by coming after it.
    //
    // patch and minor only, across every manager: unscoped on purpose, same
    // as before the migration. github-actions and pre-commit updates now
    // fall under it simply because those managers are enabled above, not
    // because this rule was widened for them; a major bump from any manager
    // still needs a person, which is exactly the case that needs a person to
    // check nothing else in this repository's tooling assumes the old
    // major's behavior.
    {
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // One grouped pull request per ecosystem, the same shape
    // dependabot.yml's `groups:` blocks gave github-actions and pre-commit
    // before this migration, down to the matching label (on top of the
    // shared `dependencies` label above).
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
      labels: ["dependencies", "github-actions"],
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      labels: ["dependencies", "pre-commit"],
    },
    // The development container's base image, pinned by digest in
    // .devcontainer/Dockerfile.
    //
    // enabledManagers turns the dockerfile manager on for the whole
    // repository, and matchFileNames on a package rule scopes that rule, not
    // which files the manager reads. So the pair below is what keeps the
    // manager to one file: everything the dockerfile manager finds is
    // disabled, then this single path is enabled again. Any other Dockerfile
    // this repository grows later stays unwatched, and cannot pick up the
    // unscoped patch and minor automerge grant at the top of this list,
    // until someone widens this deliberately.
    {
      matchManagers: ["dockerfile"],
      enabled: false,
    },
    // Not automerged, in a repository that has no `Pin Only` fast lane at
    // all: every bot pull request here is graded like a human one, and a
    // base image change is one a person should look at regardless.
    // GHCR returns no release timestamp for a digest, so under Renovate's
    // default minimumReleaseAgeBehaviour (timestamp-required) the seven day
    // window above would hold every base image bump forever and, with
    // internalChecksFilter strict, never open the pull request at all.
    // Measured with a dry-run=full: "digest update of
    // ghcr.io/ivan-pinatti-labs/devcontainer-base has no releaseTimestamp to
    // age against". timestamp-optional lets the update be offered; the review
    // stands in for the age window.
    {
      matchManagers: ["dockerfile"],
      matchFileNames: [".devcontainer/Dockerfile"],
      enabled: true,
      groupName: "development container base image",
      groupSlug: "devcontainer-base",
      labels: ["dependencies", "tooling"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: false,
    },
  ],

}
